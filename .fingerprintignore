# Ignore ALL android/ios build artifacts inside node_modules.
# These are generated by Gradle/CocoaPods during local builds and contain
# machine-specific data (paths, timestamps, .dex classes, generated sources).
# They hash differently between local Windows and EAS Linux, causing fingerprint mismatch.
node_modules/**/android/build
node_modules/**/android/build/**/*
**/node_modules/**/android/build
**/node_modules/**/android/build/**/*
node_modules/**/ios/build
node_modules/**/ios/build/**/*
**/node_modules/**/ios/build
**/node_modules/**/ios/build/**/*

# Ignore temporary Expo dev-client install artifacts
node_modules/.expo-*
node_modules/.expo-*/**/*

# @react-native-masked-view/masked-view mutates this manifest during Android Gradle
# configuration by removing the legacy package attribute when AGP namespaces are used.
node_modules/@react-native-masked-view/masked-view/android/src/main/AndroidManifest.xml

# react-native-libsodium contains platform-specific binaries that hash differently
# between local Windows and EAS Linux build servers.
node_modules/react-native-libsodium/**/*
