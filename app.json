{
  "expo": {
    "name": "Mediscan",
    "slug": "mediscan-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mediscanmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.application.mediscanmobile",
      "adaptiveIcon": {
        "backgroundColor": "#e8ede9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d7377",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0b0e11"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Mediscan uses the camera to scan another person's emergency QR code."
        }
      ],
      [
        "react-native-libsodium",
        {}
      ],
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Mediscan uses Bluetooth to sync updates with another device when both people are physically present."
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.application.mediscanmobile",
          "widgets": [
            {
              "name": "EmergencyQrWidget",
              "displayName": "Emergency QR",
              "description": "View your emergency medical QR code",
              "supportedFamilies": [
                "systemSmall",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "536d2ff6-5e5f-4e00-8afb-35584d94b29f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/536d2ff6-5e5f-4e00-8afb-35584d94b29f"
    }
  }
}
