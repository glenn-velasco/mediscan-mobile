# Copy this file to .env and fill in real values.
# Only EXPO_PUBLIC_* variables are readable from app code — see https://docs.expo.dev/guides/environment-variables/

# App root only — do NOT include /api here, endpoint calls already prefix each request with api/v1/...
EXPO_PUBLIC_API_URL=http://0.0.0.0

# Reverb / broadcasting (placeholders — replace with real deployment values)
EXPO_PUBLIC_REVERB_APP_KEY=replace-with-reverb-app-key
EXPO_PUBLIC_REVERB_HOST=0.0.0.0
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=ws
