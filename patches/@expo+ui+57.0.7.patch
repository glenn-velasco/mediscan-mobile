+@OptIn(ExperimentalMaterial3Api::class)
+private fun syncSelectedDateToDisplayedMonth(
+  selectedDateMillis: Long?,
+  displayedMonthMillis: Long,
+  selectableDates: SelectableDates
+): Long? {
+  val currentSelected = selectedDateMillis ?: return null
+  val utcZone = java.util.TimeZone.getTimeZone("UTC")
+  val selectedCal = Calendar.getInstance(utcZone).apply { timeInMillis = currentSelected }
+  val displayedCal = Calendar.getInstance(utcZone).apply { timeInMillis = displayedMonthMillis }
+  val displayedYear = displayedCal.get(Calendar.YEAR)
+  val displayedMonth = displayedCal.get(Calendar.MONTH)
+  if (
+    selectedCal.get(Calendar.YEAR) == displayedYear &&
+    selectedCal.get(Calendar.MONTH) == displayedMonth
+  ) {
+    return currentSelected
+  }
+  val day = selectedCal.get(Calendar.DAY_OF_MONTH)
+  displayedCal.set(Calendar.DAY_OF_MONTH, 1)
+  val maxDay = displayedCal.getActualMaximum(Calendar.DAY_OF_MONTH)
+  displayedCal.set(Calendar.DAY_OF_MONTH, minOf(day, maxDay))
+  displayedCal.set(Calendar.HOUR_OF_DAY, 0)
+  displayedCal.set(Calendar.MINUTE, 0)
+  displayedCal.set(Calendar.SECOND, 0)
+  displayedCal.set(Calendar.MILLISECOND, 0)
+  val candidate = displayedCal.timeInMillis
+  return if (selectableDates.isSelectableDate(candidate) && selectableDates.isSelectableYear(displayedYear)) {
+    candidate
+  } else {
+    currentSelected
+  }
+}
 
