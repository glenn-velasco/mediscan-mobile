diff --git a/node_modules/react-native-libsodium/android/CMakeLists.txt b/node_modules/react-native-libsodium/android/CMakeLists.txt
index aea3c38..acec664 100644
--- a/node_modules/react-native-libsodium/android/CMakeLists.txt
+++ b/node_modules/react-native-libsodium/android/CMakeLists.txt
@@ -3,6 +3,17 @@ cmake_minimum_required(VERSION 3.4.1)
 set (CMAKE_VERBOSE_MAKEFILE ON)
 set (CMAKE_CXX_STANDARD 20)
 
+# On Windows, AGP passes NODE_MODULES_DIR with backslashes. Those get embedded verbatim into the
+# add_library() source list below, which the CMake File API metadata generator later re-parses as
+# a quoted string — backslash+letter sequences like "\m" (e.g. from "...\mediscan-mobile\...")
+# aren't valid CMake escapes, so a fresh (uncached) configure fails with "Invalid character escape".
+# Forward slashes are always safe here and sidestep the re-parse entirely.
+# Note: this is cross-compiling to Android, so WIN32 (target OS) is always false here even on a
+# Windows host — CMAKE_HOST_WIN32 is the one that reflects the actual host running the build.
+if (CMAKE_HOST_WIN32)
+  string(REPLACE "\\" "/" NODE_MODULES_DIR "${NODE_MODULES_DIR}")
+endif()
+
 # add directories to "include" search paths
 include_directories(
             ../cpp
