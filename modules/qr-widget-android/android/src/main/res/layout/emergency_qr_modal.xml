<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:background="#FFFFFF"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:padding="20dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/qr_widget_desc"
      android:textColor="#1A1D21"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/qr_fullscreen_close"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:clickable="true"
      android:contentDescription="@string/qr_close"
      android:focusable="true"
      android:gravity="center"
      android:text="X"
      android:textColor="#1A1D21"
      android:textSize="18sp"
      android:textStyle="bold" />
  </LinearLayout>

  <!-- Sized at runtime relative to the screen so the code stays scannable on any device. -->
  <ImageView
    android:id="@+id/qr_fullscreen_image"
    android:layout_width="240dp"
    android:layout_height="240dp"
    android:contentDescription="@string/qr_widget_desc"
    android:scaleType="fitCenter" />

  <TextView
    android:id="@+id/qr_fullscreen_empty"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:maxWidth="260dp"
    android:text="@string/qr_fullscreen_empty"
    android:textColor="#1A1D21"
    android:textSize="15sp"
    android:visibility="gone" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/qr_modal_hint"
    android:textColor="#6B7280"
    android:textSize="13sp" />

</LinearLayout>
